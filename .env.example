# ---------------------------------------------------------------------------
# Copy to .env.local (Next.js) — never commit real values.
# Prisma CLI reads .env.local through prisma7.config.ts.
# ---------------------------------------------------------------------------

# Supabase Postgres.
# App/runtime: use the transaction pooler (port 6543, pgbouncer=true).
# Migrations:   use the direct connection or session pooler (port 5432).
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Supabase Storage (teacher avatars). Service-role key is server-only.
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="teacher-avatar"
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET="teacher-avatar"

# Auth.js
# Generate with: npx auth secret
AUTH_SECRET=""
AUTH_TRUST_HOST="true"
# Public origin in production, e.g. https://eval.example.edu.ph
AUTH_URL="http://localhost:3000"

# Rate limiting lives in the rate_limits table; no extra service is needed.
# Behind a reverse proxy locally, set this so X-Forwarded-For is trusted.
# Vercel is trusted automatically.
TRUST_PROXY="false"

# Transactional email for 2FA codes.
# Prefer Resend; SMTP is kept as a fallback for local/Gmail setups.
RESEND_API_KEY=""
MAIL_FROM="no-reply@example.com"
MAIL_FROM_NAME="TVET Digital Feedback"

SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE="tls"

# Application
APP_NAME="TVET Digital Feedback"
APP_TIMEZONE="Asia/Manila"

# scripts/seed.mjs — the administrator created on a fresh database.
# Leave the password blank to generate a random one and print it once.
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_FULL_NAME="System Administrator"

# Legacy MySQL source, used only by scripts/migrate-mysql.mjs
MYSQL_HOST="localhost"
MYSQL_PORT="3306"
MYSQL_USER="root"
MYSQL_PASSWORD=""
MYSQL_DATABASE="evaluation"
