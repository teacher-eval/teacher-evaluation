// TVET Digital Feedback â€” data model
//
// Mirrors the legacy MySQL schema in ../../backend/database/schema.sql so the
// existing data can be migrated without restructuring. Deliberate choices:
//
// * Table/column names stay snake_case via @@map/@map â€” the migration script
//   loads straight from the old tables.
// * `users.status` stays a free-form string (it was varchar(50) in MySQL) while
//   the other status columns are real enums, matching the source exactly.
// * `reactions` keeps the fixed q1..q10 columns for a 1:1 port. Normalising
//   them into an answer table is a follow-up, not a blocker.
// * The unique index on reactions enforces the "one evaluation per student,
//   teacher, subject and day" rule that PHP only checked in application code.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  admin
  teacher
  student
}

enum RecordStatus {
  active
  inactive
}

enum RatingLabel {
  outstanding
  very_satisfactory  @map("very satisfactory")
  satisfactory
  needs_improvements @map("needs improvements")
  poor
}

enum TwoFactorMethod {
  totp
  email
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique @db.VarChar(50)
  password  String   @db.VarChar(255)
  fullName  String   @map("full_name") @db.VarChar(100)
  role      UserRole
  status    String   @default("active") @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  student    Student?
  teacher    Teacher?
  twoFactor  User2fa?
  reactions  Reaction[]
  challenges AuthChallenge[]

  @@index([role])
  @@index([status])
  @@index([role, status])
  @@map("users")
}

model Student {
  id        Int          @id @default(autoincrement())
  userId    Int          @unique @map("user_id")
  course    String       @db.VarChar(50)
  yearLevel Int          @map("year_level")
  status    RecordStatus @default(active)
  /// Number of completed semesters (0-5, 6 = graduated).
  /// Every 2 completed semesters = +1 Year Level.
  semestersCompleted Int       @default(0) @map("semesters_completed")
  /// The evaluation period key (e.g. "2026-2027_1st") the student was last active in.
  /// Prevents advancing multiple times for the same semester.
  lastCompletedPeriodKey String? @map("last_completed_period_key") @db.VarChar(50)
  /// The academic year this student was last rolled into by an admin. Deliberately not an enrollment record.
  lastPromotedAcademicYear String?   @map("last_promoted_academic_year") @db.VarChar(20)
  /// Set when a 3rd-year student completes their program. Graduates keep their account
  /// and evaluation history but are excluded from active lists.
  graduatedAt              DateTime? @map("graduated_at") @db.Timestamptz(3)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([course, yearLevel])
  @@map("students")
}

model Teacher {
  id           Int          @id @default(autoincrement())
  userId       Int          @unique @map("user_id")
  department   String?      @default("TVET") @db.VarChar(50)
  status       RecordStatus @default(active)
  profileImage String?      @map("profile_image") @db.VarChar(255)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjects  Subject[]
  reactions Reaction[]

  @@index([status])
  @@map("teachers")
}

model Course {
  id         Int      @id @default(autoincrement())
  courseCode String   @unique @map("course_code") @db.VarChar(10)
  courseName String   @map("course_name") @db.VarChar(100)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("courses")
}

model Subject {
  id          Int          @id @default(autoincrement())
  subjectName String       @map("subject_name") @db.VarChar(100)
  course      String       @db.VarChar(50)
  yearLevel   Int          @map("year_level")
  teacherId   Int          @map("teacher_id")
  status      RecordStatus @default(active)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([teacherId])
  @@index([course, yearLevel])
  @@map("subjects")
}

model EvaluationSetting {
  id           Int      @id @default(autoincrement())
  academicYear String   @map("academic_year") @db.VarChar(20)
  semester     String   @db.VarChar(20)
  startDate    DateTime @map("start_date") @db.Date
  endDate      DateTime @map("end_date") @db.Date
  isActive     Boolean  @default(false) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([isActive])
  @@map("evaluation_settings")
}

model EvaluationQuestion {
  id           Int      @id @default(autoincrement())
  questionNo   Int      @map("question_no")
  questionText String   @map("question_text") @db.VarChar(500)
  isActive     Boolean  @default(true) @map("is_active")
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("evaluation_questions")
}

model User2fa {
  id         Int             @id @default(autoincrement())
  userId     Int             @unique @map("user_id")
  isEnabled  Boolean         @default(false) @map("is_enabled")
  method     TwoFactorMethod @default(email)
  totpSecret String?         @map("totp_secret") @db.VarChar(100)
  email      String?         @unique @db.VarChar(100)
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_2fa")
}

model Reaction {
  id        Int         @id @default(autoincrement())
  studId    Int         @map("stud_id")
  teacherId Int         @map("teacherid")
  subject   String      @db.VarChar(150)
  q1        Int         @default(0) @db.SmallInt
  q2        Int         @default(0) @db.SmallInt
  q3        Int         @default(0) @db.SmallInt
  q4        Int         @default(0) @db.SmallInt
  q5        Int         @default(0) @db.SmallInt
  q6        Int         @default(0) @db.SmallInt
  q7        Int         @default(0) @db.SmallInt
  q8        Int         @default(0) @db.SmallInt
  q9        Int         @default(0) @db.SmallInt
  q10       Int         @default(0) @db.SmallInt
  feels     RatingLabel
  comments  String?
  date      DateTime    @db.Date
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  // reactions.stud_id references users.id (not students.id) â€” legacy quirk.
  student User    @relation(fields: [studId], references: [id], onDelete: Cascade)
  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([studId, teacherId, subject, date], name: "unique_daily_evaluation")
  @@index([studId])
  @@index([teacherId])
  @@index([date])
  @@index([feels])
  @@index([subject])
  @@index([teacherId, date])
  @@map("reactions")
}

/// Server-side state for a pending 2FA challenge.
///
/// PHP kept this in $_SESSION; on Vercel there is no server session store, and
/// putting the code hash or attempt counter in a cookie would let the client
/// replay a fresh challenge. A small table keeps the state authoritative.
model AuthChallenge {
  id         String          @id @default(cuid())
  userId     Int             @map("user_id")
  method     TwoFactorMethod
  codeHash   String?         @map("code_hash")
  expiresAt  DateTime        @map("expires_at") @db.Timestamptz(3)
  attempts   Int             @default(0)
  consumedAt DateTime?       @map("consumed_at") @db.Timestamptz(3)
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("auth_challenges")
}

/// Fixed-window counters backing login/registration/2FA rate limits.
///
/// Replaces the file-based limiter in backend/includes/rate_limiter.php. A row
/// per key keeps the behaviour atomic without adding a Redis dependency.
model RateLimit {
  key          String    @id
  hits         Int       @default(0)
  windowStart  DateTime  @map("window_start") @db.Timestamptz(3)
  blockedUntil DateTime? @map("blocked_until") @db.Timestamptz(3)

  @@index([windowStart])
  @@map("rate_limits")
}
