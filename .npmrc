# next-auth@5.0.0-beta.32 still declares an optional nodemailer peer of
# "^7.0.7 || ^8.0.5", but nodemailer 8.x is affected by high-severity
# addressparser/SMTP advisories (GHSA-2x7j-588g-ccc2, GHSA-v53p-9fqp-m79j,
# GHSA-wxxx-r42m-9rp8, ...). We ship 10.x, which is patched.
#
# npm treats a stale peer range as a hard install error, which made every
# Vercel build fail in ERESOLVE before compilation even started. Ignoring peer
# ranges is safe here: nodemailer is only used by our own mail helper, not by
# next-auth (the Email provider is unused - this app uses Credentials only).
legacy-peer-deps=true
